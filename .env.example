# Copy to .env.local for local development, or add these in Vercel → Settings → Environment Variables.

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Signs session cookies. Required on Vercel, otherwise each instance uses its own key and
# users get signed out. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=your_auth_secret

# ─── Modes ────────────────────────────────────────────────────────────────────
# Inlined at build time — on Vercel, redeploy after changing them.
#
# Dev Mode: creates the demo accounts below; sign in on the login page with their email and
# password. Keep false with real data.
NEXT_PUBLIC_DEV_MODE=false
# Maintenance Mode: every page redirects to /maintenance and the API answers 503.
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ─── Demo accounts (only used when NEXT_PUBLIC_DEV_MODE=true) ────────────────
# Created automatically when a brand-new database is set up (fresh deploy, or no data/db.json),
# so the app skips /setup. Each account needs both EMAIL and PASSWORD (min 8 characters);
# NAME is optional. Leave a pair blank to skip that account. Never commit real passwords.
SUPERADMIN_NAME=Demo Super Admin
SUPERADMIN_EMAIL=superadmin@stockvault.local
SUPERADMIN_PASSWORD=

ADMIN_NAME=Alex Admin
ADMIN_EMAIL=admin@stockvault.local
ADMIN_PASSWORD=

# Manager is a custom role (view/create/edit products, record stock), created on first use.
MANAGER_NAME=Morgan Manager
MANAGER_EMAIL=manager@stockvault.local
MANAGER_PASSWORD=

STAFF_NAME=Sam Staff
STAFF_EMAIL=staff@stockvault.local
STAFF_PASSWORD=

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave blank to use the local JSON database (data/db.json; on Vercel a temp folder that
# resets when the instance restarts). Set both to use Supabase instead (run supabase/schema.sql first).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: where local data, logs and backups are stored (default: ./data, or the temp dir on Vercel).
# INVENTORY_DATA_DIR=
